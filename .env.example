# ============================================================
# Clinevo Technologies Smart Inbox Assistant
# Environment Configuration
# ============================================================
# Copy this file to .env and update with your values
# NEVER commit .env to version control

# ============================================================
# General Configuration
# ============================================================
COMPOSE_PROJECT_NAME=smart-inbox

# ============================================================
# Python AI Service
# ============================================================
# LLM Provider: "mock" (default), "openai", or "anthropic"
LLM_PROVIDER=mock

# OpenAI Configuration (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# LLM Settings (optional)
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT_SECONDS=30

# ============================================================
# Spring Boot Backend
# ============================================================
# Database Configuration
# Default: H2 in-memory for development
DB_DRIVER=org.h2.Driver
DB_URL=jdbc:h2:mem:inboxdb
DB_USERNAME=sa
DB_PASSWORD=
DB_DIALECT=org.hibernate.dialect.H2Dialect
DB_DDL_AUTO=create-drop
DB_SHOW_SQL=false
H2_CONSOLE_ENABLED=true

# Connection pool
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=30000

# Oracle Database (uncomment for production)
# DB_DRIVER=oracle.jdbc.OracleDriver
# DB_URL=jdbc:oracle:thin:@//your-oracle-host:1521/your-service-name
# DB_USERNAME=your-oracle-username
# DB_PASSWORD=your-oracle-password
# DB_DIALECT=org.hibernate.dialect.OracleDialect
# DB_DDL_AUTO=validate
# H2_CONSOLE_ENABLED=false
# DB_POOL_MAX_SIZE=20
# DB_POOL_MIN_IDLE=5
# DB_POOL_IDLE_TIMEOUT=30000

# AI Service URL (internal Docker network)
AI_SERVICE_BASE_URL=http://ai-service:8001
AI_SERVICE_TIMEOUT_MS=30000

# IMAP Email Configuration
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-email@example.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX
IMAP_SSL=true

# ============================================================
# Angular Frontend
# ============================================================
# Backend API URL (internal Docker network)
# Note: This is configured in nginx.conf, not needed in .env
