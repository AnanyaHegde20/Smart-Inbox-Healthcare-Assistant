# ============================================================================
# Smart Inbox Assistant - Database Configuration
# ============================================================================
# Copy this file to .env and fill in the values.
# Do NOT commit the .env file with real credentials.
# ============================================================================

# Database driver: "oracle" for production, "h2" for development
DB_DRIVER=oracle

# Oracle connection URL
DB_URL=jdbc:oracle:thin:@localhost:1521:ORCL

# Database credentials
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JPA dialect (auto-detected in most cases)
DB_DIALECT=org.hibernate.dialect.OracleDialect

# DDL auto: "none" for Oracle (use schema.sql), "update" for H2
DB_DDL_AUTO=none

# Show SQL (true/false)
DB_SHOW_SQL=false

# H2 console (only for development)
H2_CONSOLE_ENABLED=false

# Connection pool settings
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=30000
